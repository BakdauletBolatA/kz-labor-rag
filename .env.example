# Скопируйте в .env и заполните. .env в git не попадает (.gitignore).
#
# Ответы генерирует локальная модель в Ollama — ключ для неё не нужен.
# Ключ Anthropic нужен только LLM-судье (evals/answer_eval.py): без него
# метрики судьи записываются как null, всё остальное считается.

ANTHROPIC_API_KEY=

# Опционально: сравнительный прогон с судьёй другого вендора.
OPENAI_API_KEY=

# --- postgres + pgvector (значения совпадают с docker-compose) ---
POSTGRES_USER=kzrag
POSTGRES_PASSWORD=kzrag
POSTGRES_DB=kzrag
POSTGRES_PORT=5432
# Только для запуска скриптов без Docker: адрес базы на хосте. В compose
# адрес для api задаётся сам (хост db внутри сети compose).
# KZRAG_DATABASE_URL=postgresql://kzrag:kzrag@localhost:5432/kzrag

# --- Ollama ---
OLLAMA_PORT=11436
# Модель, которую compose скачивает в сервис ollama-pull.
KZRAG_GENERATION_MODEL=qwen2.5:7b-instruct
# Адрес Ollama для запуска без Docker; в compose задан автоматически.
# KZRAG_OLLAMA_URL=http://localhost:11436

# --- разрешённые переопределения конфига ---
# Всё остальное меняется только правкой config/default.yaml,
# иначе прогон невоспроизводим по записанному JSON.
# KZRAG_CONFIG=config/default.yaml
# KZRAG_VERSION=
# KZRAG_EVAL_DATASET=
# KZRAG_DEVICE=cpu
