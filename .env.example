# Скопируйте в .env и заполните. .env в git не попадает (.gitignore).
#
# Ключ нужен только для генерации ответов и судьи faithfulness.
# Без него харнесс работает и считает все метрики поиска
# (recall@5, MRR, clause-метрики) — достаточно выставить
# generation.enabled: false и judge.enabled: false в конфиге.

ANTHROPIC_API_KEY=

# Опционально: сравнительный прогон с судьёй другого вендора.
OPENAI_API_KEY=

# --- postgres + pgvector (значения совпадают с docker-compose) ---
POSTGRES_USER=kzrag
POSTGRES_PASSWORD=kzrag
POSTGRES_DB=kzrag
KZRAG_DATABASE_URL=postgresql://kzrag:kzrag@db:5432/kzrag

# --- разрешённые переопределения конфига ---
# Всё остальное меняется только правкой config/default.yaml,
# иначе прогон невоспроизводим по записанному JSON.
# KZRAG_CONFIG=config/default.yaml
# KZRAG_VERSION=
# KZRAG_EVAL_DATASET=
# KZRAG_DEVICE=cpu
